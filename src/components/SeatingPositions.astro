---
import { Image } from 'astro:assets';
import deskIdeal from '../assets/images/desk-ideal.jpg';
import deskUnfavourable from '../assets/images/desk-unfavourable.jpg';
import { resolveLocale, useTranslations } from '../i18n';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const images = [deskIdeal, deskUnfavourable];
const badgeTone = { ok: 'bg-approve', warn: 'bg-caution' } as const;
---

<div class="mt-8 desk:mt-14">
  <p class="mx-auto mb-5 flex items-center justify-center gap-2.5 desk:mb-7 desk:gap-3" data-reveal>
    <span class="inline-block h-[7px] w-6 flex-none rounded-[4px] bg-guide desk:h-2 desk:w-[26px]"
    ></span>
    <span class="text-[0.75rem] font-light text-sage desk:text-[0.8125rem]">
      {t.fengShui.seating.legend}
    </span>
  </p>

  <ul
    class="mx-auto flex max-w-[820px] flex-col gap-4 desk:grid desk:grid-cols-2 desk:items-stretch desk:gap-7"
    data-reveal-group
  >
    {
      t.fengShui.seating.positions.map((position, index) => (
        <li class="flex h-full flex-col overflow-hidden rounded-2xl border border-line/55 bg-white shadow-soft">
          <div class="zoom-frame w-full">
            <Image
              src={images[index]}
              alt={position.title}
              widths={[380, 560, 760]}
              sizes="(min-width: 900px) 380px, 100vw"
              class="block aspect-1139/1314 w-full object-cover"
              loading="lazy"
            />
          </div>
          <div class="flex flex-1 items-start gap-[11px] px-[18px] pt-[18px] pb-5 desk:gap-3 desk:px-[22px] desk:pt-[22px] desk:pb-[26px]">
            <span
              class:list={[
                'flex size-6 flex-none items-center justify-center rounded-full text-sm font-semibold text-cream desk:size-[26px] desk:text-[0.9375rem]',
                badgeTone[position.tone],
              ]}
            >
              {position.badge}
            </span>
            <div>
              <p class="font-serif text-serif-sm font-semibold text-taupe">{position.title}</p>
              <p class="mt-1.5 text-[0.84375rem] leading-[1.7] font-light text-taupe desk:text-[0.875rem]">
                {position.text}
              </p>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</div>
