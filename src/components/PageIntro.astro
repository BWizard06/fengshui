---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  align?: 'center' | 'start';
  class?: string;
}

const { eyebrow, title, lead, align = 'center', class: className } = Astro.props;
---

<div class:list={[align === 'center' ? 'text-center' : 'text-left', className]} data-reveal-group>
  <p class="script-accent text-script">{eyebrow}</p>
  <h1 class="mt-1 text-h1 desk:mt-1.5">{title}</h1>
  {
    lead && (
      <p
        class:list={[
          'mt-2.5 text-lead font-light desk:mt-3.5',
          align === 'center' && 'mx-auto max-w-[560px]',
        ]}
      >
        {lead}
      </p>
    )
  }
</div>
