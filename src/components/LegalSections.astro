---
interface Section {
  title: string;
  paragraphs?: readonly string[];
  lines?: readonly string[];
  items?: readonly string[];
}

interface Props {
  sections: readonly Section[];
}

const { sections } = Astro.props;
---

<div class="flex flex-col gap-7 desk:gap-9" data-reveal-group>
  {
    sections.map((section) => (
      <section>
        <h2 class="mb-2.5 text-h2-sm desk:mb-3">{section.title}</h2>

        {section.paragraphs?.map((paragraph) => (
          <p class="mb-3 text-body font-light last:mb-0" set:html={paragraph} />
        ))}

        {section.lines && (
          <p
            class="mt-3.5 text-body leading-[1.9] font-light"
            set:html={section.lines.join('<br />')}
          />
        )}

        {section.items && (
          <ul class="mt-3.5 flex flex-col gap-3">
            {section.items.map((item) => (
              <li class="border-l border-blush pl-4 text-body-sm font-light" set:html={item} />
            ))}
          </ul>
        )}
      </section>
    ))
  }
</div>
