---
import { resolveLocale, useTranslations } from '../i18n';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<ul
  class="mx-auto my-6 grid max-w-[520px] grid-cols-3 gap-1.5 desk:my-[34px] desk:gap-2"
  data-reveal-group
>
  {
    t.fengShui.bagua.trigramGrid.map((cell) => (
      <li class="flex aspect-square flex-col items-center justify-center gap-2 rounded-[10px] border border-line/70 bg-white p-1 desk:gap-[11px]">
        <span class="font-serif text-[1.0625rem] leading-none font-semibold text-taupe desk:text-[1.375rem]">
          {cell.pinyin}
        </span>
        {cell.lines && (
          <span class="flex w-9 flex-col gap-1 desk:w-[46px] desk:gap-[5px]">
            {cell.lines.map((line) =>
              line === 1 ? (
                <span class="block h-[5px] rounded-[1px] bg-gold desk:h-1.5" />
              ) : (
                <span class="flex gap-[7px] desk:gap-[9px]">
                  <span class="h-[5px] flex-1 rounded-[1px] bg-gold desk:h-1.5" />
                  <span class="h-[5px] flex-1 rounded-[1px] bg-gold desk:h-1.5" />
                </span>
              )
            )}
          </span>
        )}
        {cell.hanzi && (
          <span class="text-[1.0625rem] tracking-[1px] text-gold desk:text-[1.375rem] desk:tracking-[2px]">
            {cell.hanzi}
          </span>
        )}
        <span class="text-[0.5625rem] tracking-[0.3px] text-mute desk:text-[0.6875rem] desk:tracking-[0.5px]">
          {cell.direction}
        </span>
      </li>
    ))
  }
</ul>
