---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { htmlLang, localizePath, locales, resolveLocale, useTranslations } from '../i18n';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
}

const { title, description, path, ogImage } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const canonical = new URL(localizePath(path, locale), Astro.site);
const socialImage = new URL(ogImage ?? '/og-image.jpg', Astro.site);
const fullTitle = path === '/' ? title : `${title} · ${t.site.shortName}`;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {
      locales.map((alt) => (
        <link
          rel="alternate"
          hreflang={htmlLang[alt]}
          href={new URL(localizePath(path, alt), Astro.site)}
        />
      ))
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.site.name} />
    <meta property="og:locale" content={htmlLang[locale].replace('-', '_')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#FBF6F2" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-96.png" sizes="96x96" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <ClientRouter />
  </head>
  <body class="flex min-h-dvh flex-col bg-cream">
    <Header path={path} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
