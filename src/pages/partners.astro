---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import brunner from '../assets/images/partner-brunner.jpg';
import gonzalo from '../assets/images/partner-gonzalo.jpg';
import ben from '../assets/images/partner-ben.jpg';
import { resolveLocale, useTranslations } from '../i18n';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const [cecile, natureFirst, gonzaloEntry, benEntry] = t.partners.entries;
const cardClass =
  'rounded-[18px] border border-line/55 bg-white px-5 pt-[22px] pb-[26px] desk:px-8 desk:py-7';
const nameClass = 'font-serif text-serif-lg font-semibold text-taupe';
const roleClass = 'eyebrow mt-1.5 text-sage';
const linkClass =
  'inline-block border-b border-blush pb-0.5 text-[0.71875rem] font-medium tracking-[0.125rem] uppercase no-underline desk:text-xs';
---

<BaseLayout
  title={t.meta.partners.title}
  description={t.meta.partners.description}
  path="/partners"
>
  <div class="wrap max-w-[820px] pt-8 pb-11 desk:pt-16 desk:pb-24">
    <PageIntro eyebrow={t.partners.eyebrow} title={t.partners.title} class="mb-7 desk:mb-14" />

    <ul class="flex flex-col gap-[18px] desk:gap-6" data-reveal-group>
      <li class={cardClass}>
        <div class="desk:flex desk:items-center desk:gap-[30px]">
          <div
            class="zoom-frame mb-[18px] w-full rounded-xl desk:mb-0 desk:size-[190px] desk:flex-none"
          >
            <Image
              src={brunner}
              alt={cecile.imageAlt ?? ''}
              widths={[380, 560, 760]}
              sizes="(min-width: 900px) 190px, 100vw"
              class="block aspect-4/3 w-full object-cover desk:aspect-square desk:h-full"
              loading="eager"
            />
          </div>
          <div class="desk:min-w-[260px] desk:flex-1">
            <p class={nameClass}>{cecile.name}</p>
            <p class={roleClass}>{cecile.role}</p>
            <p class="mt-3 mb-3.5 text-body-sm font-light desk:mt-3.5 desk:mb-4">
              <a href={cecile.linkHref} target="_blank" rel="noopener">{cecile.linkInText}</a>{
                cecile.textAfter
              }
            </p>
            <a href={cecile.linkHref} target="_blank" rel="noopener" class={linkClass}>
              {cecile.linkLabel}
            </a>
          </div>
        </div>
      </li>

      <li class={cardClass}>
        <p class={nameClass}>{natureFirst.name}</p>
        <p class={roleClass}>{natureFirst.role}</p>
        <p class="mt-3 text-body-sm font-light desk:mt-3.5">{natureFirst.text}</p>
      </li>

      {
        [
          { entry: gonzaloEntry, image: gonzalo },
          { entry: benEntry, image: ben },
        ].map(({ entry, image }) => (
          <li class={cardClass}>
            <div class="grid grid-cols-[88px_1fr] items-center gap-x-4 gap-y-0 desk:grid-cols-[170px_1fr] desk:gap-x-[30px]">
              <div class="zoom-frame h-[98px] w-[88px] rounded-xl desk:row-span-2 desk:h-[190px] desk:w-[170px]">
                <Image
                  src={image}
                  alt={entry.imageAlt ?? ''}
                  widths={[180, 340, 520]}
                  sizes="(min-width: 900px) 170px, 88px"
                  class="block h-full w-full object-cover object-top"
                  loading="lazy"
                />
              </div>
              <div>
                <p class={nameClass}>{entry.name}</p>
                <p class={roleClass}>{entry.role}</p>
              </div>
              <div class="col-span-2 mt-4 desk:col-span-1 desk:col-start-2 desk:row-start-2 desk:mt-3.5">
                <p class="text-body-sm font-light">{entry.text}</p>
                {entry.linkHref && (
                  <a
                    href={entry.linkHref}
                    target="_blank"
                    rel="noopener"
                    class={`${linkClass} mt-3.5`}
                  >
                    {entry.linkLabel}
                  </a>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
