---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { business } from '../../config';
import { htmlLang, localizePath, resolveLocale, useTranslations } from '../../i18n';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content } = await render(post);

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const publishedOn = new Intl.DateTimeFormat(htmlLang[locale], {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
}).format(post.data.publishDate);

const shareImage = post.data.cover
  ? await getImage({ src: post.data.cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' })
  : undefined;

const articleUrl = new URL(`/blog/${post.id}`, Astro.site).href;

const articleData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  ...(post.data.description ? { description: post.data.description } : {}),
  datePublished: post.data.publishDate.toISOString().slice(0, 10),
  inLanguage: htmlLang[locale],
  author: { '@type': 'Person', name: business.owner },
  publisher: { '@id': new URL('/#business', Astro.site).href },
  mainEntityOfPage: articleUrl,
  ...(shareImage ? { image: new URL(shareImage.src, Astro.site).href } : {}),
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description ?? t.meta.blog.description}
  path={`/blog/${post.id}`}
  ogImage={shareImage?.src}
  ogType="article"
  structuredData={articleData}
>
  <article class="wrap max-w-[720px] pt-8 pb-11 desk:pt-16 desk:pb-24">
    <header class="mb-7 text-center desk:mb-12" data-reveal-group>
      <p class="mb-2.5 eyebrow text-sage">{publishedOn}</p>
      <h1 class="text-h1">{post.data.title}</h1>
    </header>

    {
      post.data.cover && (
        <div class="breakout mb-8 overflow-hidden rounded-2xl shadow-card desk:mb-14 desk:rounded-[18px]">
          <Image
            src={post.data.cover}
            alt={post.data.coverAlt ?? ''}
            widths={[420, 720, 960, 1440]}
            sizes="(min-width: 1024px) 960px, calc(100vw - 4rem)"
            class="block aspect-16/10 w-full object-cover desk:aspect-2/1"
            loading="eager"
          />
        </div>
      )
    }

    <div class="prose-fs">
      <Content />
    </div>

    <a
      href={localizePath('/blog', locale)}
      class="mt-9 inline-block border-b border-blush pb-0.5 text-[0.71875rem] font-medium tracking-[0.125rem] uppercase no-underline desk:mt-14 desk:text-xs"
    >
      {t.blog.backToOverview}
    </a>
  </article>
</BaseLayout>
