---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm';
import { resolveLocale, useTranslations } from '../i18n';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<BaseLayout title={t.meta.contact.title} description={t.meta.contact.description} path="/contact">
  <div class="wrap max-w-[1100px] pt-8 pb-11 desk:pt-16 desk:pb-24">
    <div
      class="grid items-start gap-0 desk:grid-cols-2 desk:grid-rows-[auto_1fr] desk:gap-x-18 desk:gap-y-0"
    >
      <div class="desk:col-start-1 desk:row-start-1" data-reveal-group>
        <p class="script-accent text-script">{t.contact.eyebrow}</p>
        <h1 class="mt-1 mb-4 text-h1 desk:mt-1.5 desk:mb-[22px]">{t.contact.title}</h1>
        <p class="mb-4 text-body font-light">{t.contact.paragraphs[0]}</p>
        <p class="mb-[26px] text-body font-light desk:mb-[34px]">{t.contact.paragraphs[1]}</p>
      </div>

      <div
        class="rounded-[20px] border border-blush/42 bg-white px-5 py-[26px] shadow-lift desk:col-start-2 desk:row-span-2 desk:row-start-1 desk:px-[38px] desk:py-10"
        data-reveal
      >
        <ContactForm
          client:load
          labels={{
            name: t.contact.form.name,
            email: t.contact.form.email,
            message: t.contact.form.message,
            newsletter: t.contact.form.newsletter,
            newsletterHint: t.contact.form.newsletterHint,
            submit: t.actions.sendMessage,
            sending: t.forms.sending,
            successTitle: t.contact.form.success.title,
            successText: t.contact.form.success.text,
          }}
          errors={t.forms.errors}
          fieldErrors={t.forms.fields}
        />
      </div>

      <div
        class="mt-7 border-t border-line/55 pt-[22px] desk:col-start-1 desk:row-start-2 desk:mt-0 desk:pt-6"
        data-reveal
      >
        <p class="mb-1.5 eyebrow text-sage desk:mb-2">{t.contact.addressLabel}</p>
        <p class="text-sm leading-[2] font-light text-taupe">
          {t.contact.address[0]}<br />{t.contact.address[1]}
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
