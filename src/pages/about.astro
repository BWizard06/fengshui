---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import portrait from '../assets/images/kati-portrait.jpg';
import warmRoom from '../assets/images/warm-living-room.jpg';
import duneGrass from '../assets/images/dune-grass.jpg';
import { resolveLocale, useTranslations } from '../i18n';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<BaseLayout title={t.meta.about.title} description={t.meta.about.description} path="/about">
  <div class="wrap max-w-[1240px] pt-8 pb-11 desk:pt-16 desk:pb-24">
    <PageIntro eyebrow={t.about.eyebrow} title={t.about.title} class="mb-7 desk:mb-14" />

    <div class="grid items-center gap-0 desk:grid-cols-[0.82fr_1.18fr] desk:gap-16">
      <figure class="m-0 mb-7 desk:mb-0">
        <Image
          src={portrait}
          alt={t.about.portraitAlt}
          widths={[420, 640, 980]}
          sizes="(min-width: 900px) 480px, 100vw"
          class="block aspect-30/37 w-full rounded-t-[150px] rounded-b-[20px] object-cover object-[38%_center] shadow-card desk:aspect-10/13 desk:rounded-t-[220px] desk:rounded-b-3xl"
          loading="eager"
        />
        <figcaption
          class="mt-3.5 text-center font-serif text-[1.1875rem] text-mute italic desk:mt-[18px] desk:text-[1.375rem]"
        >
          {t.about.portraitCaption}
        </figcaption>
      </figure>
      <div>
        {t.about.intro.map((paragraph) => <p class="mb-4 text-body font-light">{paragraph}</p>)}
      </div>
    </div>

    <div
      class="mt-0 grid items-center gap-0 desk:mt-16 desk:grid-cols-[1.12fr_0.88fr] desk:gap-x-16 desk:gap-y-0"
    >
      <p class="text-body font-light desk:col-start-1 desk:row-start-1 desk:mb-0">
        {t.about.middleLead}
      </p>
      <Image
        src={warmRoom}
        alt={t.about.roomAlt}
        widths={[420, 640, 1040]}
        sizes="(min-width: 900px) 520px, 100vw"
        class="my-6 block aspect-1024/682 w-full rounded-2xl object-cover shadow-card desk:col-start-2 desk:row-span-2 desk:row-start-1 desk:my-0 desk:rounded-[18px]"
        loading="lazy"
      />
      <div class="desk:col-start-1 desk:row-start-2 desk:mt-[18px]">
        {
          t.about.middle.map((paragraph, index) => (
            <p class:list={['text-body font-light', index === 0 && 'mb-4']}>{paragraph}</p>
          ))
        }
      </div>
    </div>

    <blockquote class="mx-auto my-7 max-w-[1020px] px-5 py-1.5 text-center desk:my-16">
      <span class="mx-auto mb-5 rule-line desk:mb-[26px]"></span>
      <p class="font-serif text-quote font-medium text-rose italic">{t.about.quote}</p>
      <span class="mx-auto mt-5 rule-line desk:mt-[26px]"></span>
    </blockquote>

    <div class="grid items-center gap-0 desk:grid-cols-[0.88fr_1.12fr] desk:gap-16">
      <Image
        src={duneGrass}
        alt={t.about.duneAlt}
        widths={[420, 640, 1040]}
        sizes="(min-width: 900px) 520px, 100vw"
        class="mb-6 block aspect-20/17 w-full rounded-2xl object-cover shadow-card desk:mb-0 desk:rounded-[18px]"
        loading="lazy"
      />
      <div>
        {t.about.rest.map((paragraph) => <p class="mb-4 text-body font-light">{paragraph}</p>)}
      </div>
    </div>

    <section
      class="mx-auto mt-7 max-w-[996px] rounded-[20px] border border-line/55 bg-blush/16 px-[22px] pt-[30px] pb-[26px] desk:mt-16 desk:rounded-[22px] desk:px-12 desk:py-13"
    >
      <h2 class="mb-[18px] text-center text-h2-sm desk:mb-[34px]">{t.about.education.title}</h2>
      <div
        class="grid gap-0 border-t border-line/55 pt-[18px] desk:grid-cols-[220px_1fr] desk:gap-7 desk:pt-[26px] desk:pb-1.5"
      >
        <p class="mb-4 font-serif text-serif-lg font-semibold text-rose desk:mb-0">
          {t.about.education.year}
        </p>
        <div class="flex flex-col gap-6 desk:gap-[30px]">
          {
            t.about.education.entries.map((entry) => (
              <div>
                <p class="mb-2.5 text-body-sm leading-[1.55] font-medium text-taupe desk:mb-3">
                  {entry.institution}
                </p>
                <ul class="flex flex-col gap-2">
                  {entry.items.map((item) => (
                    <li class="grid grid-cols-[auto_1fr] items-baseline gap-2.5 desk:gap-3">
                      <span class="text-blush">—</span>
                      <span class="text-body-sm leading-[1.7] font-light text-taupe">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
