{
  "name": "fengshui",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "wrangler types && astro check && astro build",
    "preview": "astro build && wrangler dev --config dist/server/wrangler.json",
    "check": "wrangler types && astro check",
    "rate-limit": "node scripts/rate-limit.mjs status",
    "rate-limit:test": "node scripts/rate-limit.mjs test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/react": "^6.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/allura": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.26.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.129.1"
  },
  "description": "Website Kati Schepis Feng Shui",
  "private": true
}
